                            let cell = ws1[col + (R + 1)];
                            if (cell && typeof cell.v === "number") {
                                cell.z = "#,##0";
                            }
                        });
                    }

                    let startRow = rawData.length + 15;

                    for (let R = startRow; R < startRow + 20; R++) {
