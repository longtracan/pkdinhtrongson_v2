                });

                // ===== RENDER TABLE GUI MAU =====
                function renderTable_guimau(data) {

                    // 🔥 destroy chuẩn
                    if ($.fn.DataTable.isDataTable('#table_guimau')) {
                        $('#table_guimau').DataTable().clear().destroy();
                    }

                    // 🔥 clear DOM
                    $('#tbody_data').empty();
                    let html = '';
                    data.forEach(row => {
                        html += `
            <tr>
                <td contenteditable="true">${row["TÊN DỊCH VỤ"] || ''}</td>
                <td contenteditable="true">${row["Mục"] || ''}</td>
                <td contenteditable="true">${row["Nơi gửi mẫu"] || ''}</td>
                <td contenteditable="true">${row["ĐƠN GIÁ THU"] || ''}</td>
                <td contenteditable="true">${row["ĐƠN GIÁ GỬI"] || ''}</td>
               
            </tr>`;
                    });

                    $('#tbody_data').html(html);

                    $('#table_guimau').DataTable({
                        pageLength: 5


                    });
                }

                // ===== LOAD =====
                let saved = localStorage.getItem('table_guimau');

                if (saved) {
                    $("#json_guimau").val(JSON.stringify(JSON.parse(saved), null, 2));
                }

                loadFromTextarea(); // render lần đầu

                function loadFromTextarea() {
                    try {
                        let text = $("#json_guimau").val();
                        let data = JSON.parse(text);

                        renderTable_guimau(data);

                        localStorage.setItem('table_guimau', JSON.stringify(data));

                        updateGuiMauForAllRows(); // 🔥 update GM

                    } catch (e) {
                        alert("JSON không hợp lệ!");
                    }
                }
                function updateGuiMauForAllRows() {

                    let guiMauMap = buildGuiMauMap();

                    $("#table_dulieu tbody tr").each(function () {

                        let tr = $(this);
                        let i = tr.data("index");

                        let dv = normalizeDV(rawData[i].NOIDUNG);
                        let match = guiMauMap[dv] || [];

                        let gm = tr.find(".gm");
                        let select = tr.find(".noi_gui");
                        let giaInput = tr.find(".gia_gui");

                        // build lại options
                        let options = '<option value="">--Chọn--</option>';
                        match.forEach(m => {
                            options += `<option value="${m.noi}" data-gia="${m.gia}">${m.noi}</option>`;
                        });

                        select.html(options);

                        if (match.length > 0) {

                            gm.prop("checked", true).prop("disabled", false);
                            select.prop("disabled", false);

                            state[i] = state[i] || {};
                            state[i].gm = true;

                            // auto nếu 1 nơi
                            if (match.length === 1) {
                                let noi = match[0].noi;
                                let gia = match[0].gia;

                                select.val(noi);
                                giaInput.val(fm(gia));

                                state[i].noi = noi;
                                state[i].gia = gia;
                            }

                        } else {

                            gm.prop("checked", false).prop("disabled", true);
                            select.prop("disabled", true).val('');
                            giaInput.val('');

                            state[i] = state[i] || {};
                            state[i].gm = false;
                            state[i].noi = null;
                            state[i].gia = 0;
                        }
                    });

                    calculateGuiMau(); // 🔥 cập nhật tổng
                }


                $("#btnReloadGM").on("click", function () {
                    loadFromTextarea();
                });

                function buildGuiMauMap() {
                    let map = {};

                    let table = $('#table_guimau').DataTable();

                    table.rows().every(function () {

                        let row = this.node(); // DOM của row

                        let ten = normalizeDV($(row).find('td:eq(0)').text());
                        let noi = $(row).find('td:eq(2)').text().trim();
                        let gia = pm($(row).find('td:eq(4)').text());

                        if (!ten) return;

                        if (!map[ten]) map[ten] = [];

                        map[ten].push({ noi, gia });
                    });

                    return map;
                }

                function normalizeDV(str) {
                    return (str || "")
                        .toLowerCase()
                        .replace(/\s+/g, ' ')   // gộp khoảng trắng
                        .replace(/[-–]/g, '')   // bỏ dấu -
                        .replace(/\s*\(\s*/g, '(')
                        .replace(/\s*\)\s*/g, ')')
                        .trim();
                }
            }
                // END ThongKe
            
            //end
        });
    </script>




