            // ============================
            // TẠO BẢNG TỪ JSON
            // ============================
            function renderTable_danh_gia_v2(data) {

                table_danh_gia_v2 = $('#danh_sach_danh_gia_excel').DataTable({
                    destroy: true,
                    data: data,
                    columns: [

                        { data: "ma", title: "Mã" },

                        { data: "ho_ten", title: "Họ tên" },

                        { data: "bhyt", title: "BHYT" },

                        { data: "ngay", title: "Ngày" },

                        { data: "phong", title: "Phòng" },

                        { data: "so_dien_thoai", title: "Số điện thoại" },

                        { data: "nguoi_lien_he", title: "Người liên hệ" },
                        { data: "gioi_tinh", title: "Giới tính" },

                        { data: "nam_sinh", title: "Năm sinh" },

                        { data: "trang_thai", title: "Trạng Thái" },

                        {
                            data: null,
                            title: "Thao tác",
                            render: function () {
                                return '<button class="btn_gui_danh_gia">Gửi</button>';
                            }
                        }

                    ],
                    scrollX: true
                });

            }


            // ============================
            // PARSE JSON KHI PASTE
            // ============================
            $("#json_input").on("input", function () {

                let text = $(this).val().trim();

                if (text.length < 10) return;

                let json;

                try {

                    json = JSON.parse(text);

                } catch (e) {

                    return;

                }

                let data = [];

                json.forEach(function (row) {
                    if (!row.SO_DIEN_THOAI || row.SO_DIEN_THOAI.toString().trim() === "") {
                        return;
                    }

           

                    let phone = row.SO_DIEN_THOAI.replace(/\D/g, '');

                    if (phone.startsWith("0")) {

                        phone = "84" + phone.substring(1);

                    }

                    let nguoi_lh = "";

                    if (row.HO_TEN_CHA) nguoi_lh += row.HO_TEN_CHA;

                    if (row.HO_TEN_ME) nguoi_lh += (nguoi_lh ? " - " : "") + row.HO_TEN_ME;
                    let gioi_tinh = row.GIOI_TINH == 1 ? "Nam" : "Nữ";
                    let trang_thai = row.TRANG_THAI == 3 ? "Đã khám" : " ";

                    let nam_sinh = "";

                    if (row.NGAY_SINH) {

                        nam_sinh = row.NGAY_SINH.toString().substring(0, 4);

                    }

                    data.push({

                        ma: row.MA_BENH_NHAN,

                        ho_ten: row.TEN_BENH_NHAN,

                        bhyt: row.SO_THE_BHYT,

                        ngay: row.NGAYTIEPNHAN,

                        phong: row.TEN_PHONG_BENH,

                        so_dien_thoai: phone,

                        nguoi_lien_he: nguoi_lh,

                        gioi_tinh: gioi_tinh,

                        nam_sinh: nam_sinh,

                        trang_thai: trang_thai,



                        sent: false

                    });

                });

                renderTable_danh_gia_v2(data);

            });


