                        return isThuoc(x) ? "Thuốc DV" : "Dịch vụ";
                    }

                    // =========================
                    // ===== TÍNH TỔNG =========
                    // =========================
                    let tong_dv = 0;
                    let tong_thuoc = 0;

                    rawData.forEach(x => {
                        let tien = Number(x.THANHTIEN) || 0;
                        if (isThuoc(x)) tong_thuoc += tien;
                        else tong_dv += tien;
                    });

                    // =========================
                    // ===== HEADER ============
                    // =========================
                    ws_data.push([
