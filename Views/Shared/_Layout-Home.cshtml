            function randString(n) {
                if (!n) {
                    n = 5;
                }

                var text = '';
                var possible = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';

                for (var i = 0; i < n; i++) {
                    text += possible.charAt(Math.floor(Math.random() * possible.length));
                }

                return text;
            }

            function getFirstChar($str) {
                var $result = $str.split(' ').map(function (item) { return item[0] }).join('');
                return $result.toUpperCase();
            }

            // Handle click event on group checkbox
            // gui zalo dat lich kham
            function vietHoaChuCaiDau(str) {
                return str
                    .toLowerCase()
                    .split(" ")
                    .filter(word => word)
                    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                    .join(" ");
            }


            // Validate số điện thoại VN
            function isValidPhone(phone) {
                // đầu số phổ biến VN
                let regex = /^(03|05|07|08|09)\d{8}$/;
                return regex.test(phone);
            }


            function tachThongTin(input) {

                if (!input.trim()) {
                    $("#customer_name").val("");
                    $("#number").val("");
                    $("#phone_number").val("");
                    $("#phone_sendzalo").val("");
                    $("#phone_error").text("");
                    return;
                }

                // Chuẩn hóa chuỗi
                input = input
                    .replace(/\n/g, " ")
                    .replace(/[-*_]+/g, " ")
                    .replace(/\s+/g, " ")
                    .trim();


                // Tìm số điện thoại
                let phoneMatch = input.match(/(0\d{9})/);
                let phone = "";

                if (phoneMatch) {
                    phone = phoneMatch[0];
                }


                // Tìm ngày sinh
                let birthMatch = input.match(/(\d{2}[\/\-]\d{2}[\/\-]\d{4})/);
                let birth = "";

                if (birthMatch) {
                    birth = birthMatch[0];
                }


                // Tìm năm sinh
                let yearMatch = input.match(/\b(19|20)\d{2}\b/);
                let year = "";

                if (yearMatch) {
                    year = yearMatch[0];
                }

                if (birth) {
                    year = birth.split(/[\/\-]/)[2];
                }


                // Lấy họ tên
                let name = input
                    .replace(phone, "")
                    .replace(birth, "")
                    .replace(year, "")
                    .replace(/\d+/g, "")
                    .trim();

                name = vietHoaChuCaiDau(name);


                // Validate phone
                let phoneZalo = "";

                if (phone) {
                    if (isValidPhone(phone)) {
                        

                        phoneZalo = "84" + phone.substring(1);

                        $("#phone_number").val(phone);
                        $("#phone_sendzalo").val(phoneZalo);
                    }
                    else {
                       alert("Kiểm tra lại Số điện thoại không đúng định dạng!");

                        $("#phone_number").val("");
                        $("#phone_sendzalo").val("");
                    }
                }
                else {

                    $("#phone_number").val("");
                    $("#phone_sendzalo").val("");
                }


                // Fill name + year
                $("#customer_name").val(name);
                $("#number").val(year);
                $("#customer_code").val(randString(4));

            }


            $("#raw_data").on("input", function () {
                let data = $(this).val();

                tachThongTin(data);
            });
            
