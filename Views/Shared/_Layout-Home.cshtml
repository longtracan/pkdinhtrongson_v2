                        "TM", "CK", "GM", "Hiệu chỉnh"
                    ]);

                    // =========================
                    // ===== BODY ==============
                    // =========================
                    rawData.forEach((x, i) => {

                        let st = getRowState(i);
                        let ngay = (x.NGAY_GIO_TAO || "").split(" ")[0];

                        ws_data.push([
                            i + 1,
                            ngay,
                            x.TEN_BENH_NHAN || "",
                            x.NOIDUNG || "",
                            getLoai(x),
                            Number(x.DONGIA) || 0,
                            x.SOLUONG || 0,
                            Number(x.THANHTIEN) || 0,
                            st.isTM ? 1 : 0,
                            st.isCK ? 1 : 0,
                            st.isGM ? 1 : 0,
                            st.hc
                        ]);
                    });

                    // =========================
                    // ===== GỬI MẪU ===========
                    // =========================
                    let gmData = getGuiMauSummary();

                    // =========================
                    // ===== DÒNG TRỐNG ========
                    // =========================
                    ws_data.push([]);

                    // =========================
                    // ===== TỔNG KẾT ==========
                    ws_data.push(["Số tiền đầu ngày", pm($("#dauNgay").val())]);
                    ws_data.push(["Thu ngoài", pm($("#thuNgoai").val())]);
                    ws_data.push(["Tiền mặt DV", pm($("#tm_dv").text())]);
                    ws_data.push(["Chuyển khoản DV", pm($("#ck_dv").text())]);
                    ws_data.push(["Tiền mặt Thuốc", pm($("#tm_thuoc").text())]);
                    ws_data.push(["Chuyển khoản thuốc", pm($("#ck_thuoc").text())]);
                    ws_data.push(["Chuyển khoản ra (UNC)", pm($("#unc").val())]);
                    ws_data.push(["Số dư cuối ngày TK Ngân Hàng", pm($("#cuoiNgay").text())]);
                    ws_data.push(["Lệch", pm($("#lech").val())]);

                    // =========================
                    // ===== THỐNG KÊ ==========
                    // =========================
                    ws_data.push([]);
                    ws_data.push(["===== TỔNG HỢP ====="]);
                    ws_data.push(["Tổng tiền Dịch vụ", tong_dv]);
                    ws_data.push(["Tổng tiền Thuốc", tong_thuoc]);

                    // =========================
                    // ===== GỬI MẪU ===========
                    // =========================
                    ws_data.push([]);
                    ws_data.push(["===== CHI PHÍ GỬI MẪU ====="]);

                    Object.keys(gmData.map).forEach(noi => {
                        ws_data.push([noi, gmData.map[noi]]);
                    });

